{
  "name": "@healthspec/core",
  "version": "0.0.0",
  "description": "HealthSpec provider contract, HealthStore facade, MockProvider, cursors and time buckets — pure TypeScript, no React Native dependency.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@healthspec/schema": "workspace:*"
  }
}
