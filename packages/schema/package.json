{
  "name": "@healthspec/schema",
  "version": "0.0.0",
  "description": "HealthSpec generated types, platform mapping tables, unit helpers and API semantics.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "import": "./dist/bundle.js",
      "default": "./dist/bundle.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-eyoungmin/healthspec.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/dev-eyoungmin/healthspec"
}
