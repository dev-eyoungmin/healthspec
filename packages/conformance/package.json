{
  "name": "@healthspec/conformance",
  "version": "0.0.0",
  "description": "Conformance suite every HealthSpec provider must pass. Run it against your Provider to claim compatibility.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@healthspec/core": "workspace:*",
    "@healthspec/schema": "workspace:*"
  }
}
