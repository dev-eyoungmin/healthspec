        "write": true,
        "kind": "quantity",
        "identifier": "HKQuantityTypeIdentifierPhysicalEffort",
        "unit": "kcal/(kg*hr)",
        "since": "iOS 17",
        "verifiedBy": {
          "identifiers": [
            "kingstinct-generated"
          ]
        }
      }
    },
    "notes": [],
    "verified": false
  },
  "type": "object",
  "properties": {
    "metsEquivalent": {
      "type": "number",
      "x-unit": "kcal/(kg·h)",
      "minimum": 0
    }
  },
  "required": [
