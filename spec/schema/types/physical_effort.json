{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://healthspec.dev/schema/types/physical_effort.json",
  "title": "physical_effort",
  "description": "Physical effort (MET-like) sample.",
  "x-healthspec": {
    "category": "activity",
    "kind": "sample",
    "since": "1.0",
    "aggregate": [
      "avg",
      "min",
      "max"
    ],
    "platforms": {
